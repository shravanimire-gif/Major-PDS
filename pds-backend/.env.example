NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration
# Development: Use local PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/pds
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/pds_test

# Production: Use Neon or Render PostgreSQL with SSL
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# CORS Configuration
# Comma-separated trusted browser origins.
# Development: Allow localhost ports
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Production: Set ONLY your real HTTPS domains
# CORS_ORIGINS=https://pds-frontend.onrender.com

# Development override: allow any Origin header when NODE_ENV!=production.
# Set to false to enforce CORS_ORIGINS even in development.
CORS_ALLOW_ALL_DEV_ORIGINS=true

# JWT Configuration
# SECURITY: Generate a strong random secret for production (min 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Twilio Configuration (for OTP)
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IoT Weighing Subsystem (Phase 1)
# No new required env vars — device auth uses bcrypt-hashed tokens stored in
# iot_devices (see migrations/006_create_iot_devices.js), and the admin live
# WebSocket (/ws/admin/live) reuses the existing JWT_SECRET above. Tunable
# thresholds (e.g. the 10000g sanity ceiling) live in src/config/iot.js,
# mirroring blockchainHealth.js's pattern, not env vars.

# Blockchain (Ethereum Sepolia / PDSLedger) Configuration
# If unset, blockchainService.js runs in a no-op mode: dispenses succeed and
# save normally, but nothing gets anchored on-chain (recordDispense always
# returns { success: false }) and /api/admin/blockchain/health reports "down".
# RPC endpoint — an Infura/Alchemy/etc. Sepolia URL, or a local node.
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/your-project-id
# Deployer/signer private key. With or without the 0x prefix.
BLOCKCHAIN_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Deployed PDSLedger contract address (see blockchain/deployments.json).
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Cosmetic only — included in log lines, not used for connectivity.
BLOCKCHAIN_NETWORK=sepolia

# Rate limiting (optional — the strict values below are the DEFAULTS)
# Auth: 10 attempts per 15 minutes per IP. Correct against brute force, but too
# tight for an E2E suite or a live demo that logs in as several roles in quick
# succession — both then get HTTP 429, which looks like an app failure.
# Raise ONLY in development.
# AUTH_RATE_LIMIT_MAX=200
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=100
# API_RATE_LIMIT_WINDOW_MS=60000
