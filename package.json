{
  "name": "pds-root",
  "scripts": {
    "backend": "cd pds-backend && npm run dev",
    "frontend": "cd pds-frontend && npm run dev",
    "beneficiary": "cd pds-beneficiary && npx expo start",
    "blockchain:test": "cd blockchain && npm test",
    "blockchain:local": "cd blockchain && npm run deploy:local",
    "blockchain:deploy": "cd blockchain && npm run deploy:sepolia",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "iot:bridge": "cd iot-bridge && npm start",
    "iot:devices": "cd iot-bridge && npm run devices",
    "iot:test": "cd iot-bridge && npm test",
    "iot:sniff": "cd iot-bridge && npm run sniff",
    "iot:verify": "cd iot-bridge && npm run verify"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0"
  }
}
