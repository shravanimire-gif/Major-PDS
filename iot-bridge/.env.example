# ---------------------------------------------------------------------------
# PDS IoT bridge (ESP32 -> USB serial -> pds-backend)
#
# Copy to iot-bridge/.env and fill in IOT_DEVICE_TOKEN. Everything else has a
# working default for a local Windows demo.
#
# .env is git-ignored. NEVER commit a real device token.
# ---------------------------------------------------------------------------

# ---- SERIAL ---------------------------------------------------------------
# Leave BLANK to auto-detect the ESP32 by its USB-UART vendor ID (CP210x,
# CH340, FTDI, or Espressif native USB). Set it only when several USB-serial
# adapters are attached and auto-detection reports AMBIGUOUS.
#
# Windows renumbers COM ports when a board moves to a different USB socket, so
# a pinned value can go stale. Run `npm run iot:devices` to see what is present.
IOT_SERIAL_PORT=/dev/tty.usbserial-10
IOT_SERIAL_BAUD=115200

# ---- BACKEND ------------------------------------------------------------
# pds-backend's HTTP base URL. Converted to ws:// internally for /ws/iot.
# Defaults to http://localhost:<PORT from pds-backend/.env> if left blank.
IOT_BACKEND_URL=http://localhost:5055

# ---- DEVICE ---------------------------------------------------------------
# The bearer token shown ONCE by the Admin Panel (Settings > Devices >
# Register Device), or by POST /api/admin/iot/devices. This is the only
# credential in the USB path — it lives here, not on the ESP32, because a
# secret compiled into firmware is a secret in every Serial Monitor session.
#
# If you lose it, rotate it (Admin Panel) rather than trying to recover it.
IOT_DEVICE_TOKEN=paste-the-token-shown-once-at-registration

# Normally leave BLANK: the bridge uses the UID the board reports over serial
# (ESP32-XXXXXX, derived from its factory MAC), so identity comes from the
# hardware. Set it to PIN a specific device — the bridge then refuses to run if
# the attached board reports a different UID, which stops a swapped board from
# inheriting this device's shop assignment and token.
IOT_DEVICE_ID=

# ---- TIMING (optional) --------------------------------------------------
# Reconnect backoff for both the serial port and the backend socket.
# IOT_RECONNECT_INITIAL_MS=1000
# IOT_RECONNECT_MAX_MS=30000
#
# Heartbeat to the backend. MUST stay below the backend's 45 s idle timeout
# (DEVICE_IDLE_TIMEOUT_MS in pds-backend/src/config/iot.js).
# IOT_HEARTBEAT_MS=15000

# ---- LOCAL DIAGNOSTICS (optional) --------------------------------------
# Loopback-only health endpoint: http://127.0.0.1:5099/health
# IOT_BRIDGE_HEALTH_PORT=5099
#
# Per-reading / per-dropped-line logging. Very chatty at 10 Hz.
# IOT_BRIDGE_DEBUG=1

# ---- SIMULATION (optional, NOT a hardware test) ------------------------
# Runs the bridge with a synthetic reading source and no COM port, to exercise
# the backend/Admin Panel/dispense path when the board is not attached. It
# proves nothing about the HX711, the wiring or the calibration, and every log
# line it emits says SIMULATED.
# IOT_SIMULATE=true
# IOT_SIMULATE_TARGET_GRAMS=3000
